# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Web / TypeScript / 配置
[*.{ts,tsx,js,mjs,cjs,json,jsonc,yml,yaml}]
indent_size = 2

# Markdown 保留行尾空格（用于换行）
[*.md]
trim_trailing_whitespace = false

# Windows 脚本按 .gitattributes 使用 CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Makefile / CMake 需要制表符或保持现状
[Makefile]
indent_style = tab