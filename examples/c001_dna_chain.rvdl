// ============================================================================
// c001 蝶点（shuttle_strategy=4）：压缩成点再辐射 + DNA 链多层架构
//
// ── 拓扑 ───────────────────────────────────────────────────────────────────
//
//        leaf_a1        hub_b                leaf_b1
//       coord=(1)      coord=(100)          coord=(101)
//           │            ││                    │
//           │            ││ ← 蝶点链            │
//   hub_a ──┼────────────┘┘────────────────────┼─── 主链（DNA 双链）
//  coord=(0)│            │                     │
//           │            │                     │
//        leaf_a2      （蝶点）               leaf_b2
//       coord=(2)                           coord=(102)
//
//   · hub_a / hub_b 各是一个**蝶点**（strategy=4）：全体关联层的主要特征
//     摘要汇入该点，再由该点按相位向全体辐射 —— 深度恒 1 轮。
//   · 两个蝶点之间互相 shuttle（hub_a→(100)、hub_b→(0)）：蝶点经拓扑边
//     互联成**蝶点链**（主链），层↔蝶点的连接即**横档（碱基对）**——
//     每个关联层通过自己的蝶点与全体关联层配对，构成「DNA 链」多层架构。
//   · leaf_a2 距 hub_a 为 d=2、leaf_b1 距 hub_b 为 d=1、而 hub_a↔hub_b
//     相距 d=100：**蝶式此时需要 ⌈log₂103⌉ = 7 轮**才能让最远对端收到，
//     c001 蝶点恒 1 轮 —— 这就是「压缩成点」相对「逐位翻转」的性能差。
//
// ── 运行后看什么 ───────────────────────────────────────────────────────────
//
//   stdout 里的 [Shuttle] 行（运行诊断，非静默）：
//     from=hub_a strategy=4 (显式) phase=2 rounds=1 peers=3 λ=1 span=103 …
//       · rounds=1：c001 解析深度恒 1（与 span/对端数无关）
//     [Shuttle] c001 蝶点 digest from=hub_a observables=2 peers=3 rounds=1 …
//       · 蝶点摘要被**显式物化**并打印 —— 「取主要特征」是可见的，
//         不是一句宣传语
//
// 运行：rvdl run examples/c001_dna_chain.rvdl（需先启动 runtime daemon）
// 规格：docs/rvdl-shuttle-tracking.md §3.7
// ============================================================================

// λ 必须与下面 @layer 里的 shuttle_lambda 一致：标签是规划器的权威值，
// 此处只是把它取出来供函数体做算术，两处不能各自漂移。
// （改标签时记得改这里 —— 这是唯一一处人工同步点。）
fixed double LAMBDA = 1.0;

// ── 蝶点 A：DNA 主链的 5' 端 ───────────────────────────────────────────────
// 同时向三个关联层辐射：两个本群叶子 + 另一个蝶点（链式连接）。
// 必须同时有 track=，否则 W-SHU001 会正确指出「声明了相干穿梭却没人供给影子」。
@layer(time=0, thread=0, coord=(0), cost=1,
       shuttle=((1),(2),(100)), shuttle_lambda=1, shuttle_phase=2, shuttle_strategy=4,
       track=(expect_z, entropy))
int32 hub_a() {
    int32 ok = 0;

    // ── 自检 1：对数空间的**可加性** ────────────────────────────────────────
    // logWeight 对距离是线性的：logW(a) + logW(b) == logW(a+b)。
    // 这正是「距离相加 = 权重相乘」在 log 空间的对应物，也是路由能用
    // 简单加法在任意远距离上精确比较的原因（线性空间早就下溢了）。
    //
    // 刻意用 λ=3 做这条检查：λ=1 配整数距离会得到精确的整数等式
    // （−1 + −2 == −3），那种等式恒真、测不出任何东西。
    double L3 = 3.0;
    double lw1 = -1.0 / L3;
    double lw2 = -2.0 / L3;
    double lw3 = -3.0 / L3;
    if (lw1 + lw2 - lw3 < 0.000000001 && lw1 + lw2 - lw3 > -0.000000001) {
        ok = ok + 1;                       // 1：logWeight 可加（非整数 λ 下仍成立）
    }

    // ── 自检 2：蝶点链的远端连接仍**严格可分辨** ────────────────────────────
    // hub_a↔hub_b 相距 d=100。构造链上三个递减距离验证对数序：
    // c001 的辐射用 logWeight 路由，故越洋连接不会因线性权重下溢而失序。
    double far1 = -100.0 / LAMBDA;
    double far2 = -101.0 / LAMBDA;
    double far3 = -102.0 / LAMBDA;
    if (far1 > far2 && far2 > far3) {
        ok = ok + 1;                       // 2：链式连接的对数序严格
    }
    if (far1 != far2 && far2 != far3 && far1 != far3) {
        ok = ok + 1;                       // 3：两两可分辨（无「都等于 0」退化）
    }

    // ── 自检 3：核**不留零**（无截断阈值）──────────────────────────────────
    // 任何**阈值型**实现都会在极远距离上返回 0 或丢弃对端；
    // 对数形式必须仍然有限。「有限」用有界区间验：对 ±inf / NaN，区间检查会假。
    double extreme = -1000000.0 / LAMBDA;
    if (extreme < far1 && extreme > -2000000.0) {
        ok = ok + 1;                       // 4：d=10^6 处对数权重仍有限、仍更小
    }

    // ── 自检 4：蝶点摘要里的可观测量本身是真的 ─────────────────────────────
    // 声明 track=(expect_z, entropy) 的含义是「这两个量在块的作用域内被
    // 转成经典影子再恢复，其摘要汇入蝶点」。此处算出它们的真值，
    // 作为蝶点摘要内容的基准。
    auto q = new QuantumRegister(2);
    qgate_h(q, 0);
    qgate_cnot(q, 0, 1);                   // Bell 态：(|00> + |11>)/√2

    // expect_z 属 Pauli 族 → L0（非破坏读出，保真度 = 1）
    double z0 = qexpect_z(q, 0);
    if (z0 < 0.0001 && z0 > -0.0001) {
        ok = ok + 1;                       // 5：Bell 态边缘期望 <Z> = 0
    }
    // entropy 属统计族 → L1（经典阴影，采样收敛而非单次精确）
    double s = qstate_entropy(q);
    // Bell 态约化熵 = ln 2 ≈ 0.6931
    if (s > 0.68 && s < 0.71) {
        ok = ok + 1;                       // 6：纠缠熵 ≈ ln 2
    }

    rvdl_sys_logi(1, ok);                  // 期望 6
    return ok;
}

// ── 蝶点 B：DNA 主链的 3' 端 ───────────────────────────────────────────────
// 与 hub_a 互为对端（蝶点链），同时辐射本群的两个叶子。
// 注意它**也**声明 track=（W-SHU001 的正当供给）：相干路径的影子由自己出。
@layer(time=0, thread=0, coord=(100), cost=1,
       shuttle=((0),(101),(102)), shuttle_lambda=1, shuttle_phase=2, shuttle_strategy=4,
       track=(expect_z))
int32 hub_b() {
    auto q = new QuantumRegister(1);
    qgate_h(q, 0);                         // (|0> + |1>)/√2
    double z = qexpect_z(q, 0);            // <Z> = 0
    int32 ok = 0;
    if (z < 0.0001 && z > -0.0001) {
        ok = 1;
    }
    rvdl_sys_logi(2, ok);
    return ok;
}

// ── 叶子层：经蝶点 1 轮即收到（d=1）────────────────────────────────────────
@layer(time=1, thread=0, coord=(1), cost=1, track=(expect_z))
int32 leaf_a1() {
    auto q = new QuantumRegister(1);
    qgate_h(q, 0);
    double z = qexpect_z(q, 0);
    int32 ok = 0;
    if (z < 0.0001 && z > -0.0001) {
        ok = 1;
    }
    rvdl_sys_logi(3, ok);
    return ok;
}

// ── 叶子层：经蝶点 1 轮即收到（d=2）────────────────────────────────────────
@layer(time=1, thread=0, coord=(2), cost=1, track=(num_qubits))
int32 leaf_a2() {
    auto q = new QuantumRegister(4);
    int32 n = qobj_num_qubits(q);
    int32 ok = 0;
    if (n == 4) {
        ok = 1;
    }
    rvdl_sys_logi(4, ok);
    return ok;
}

// ── 叶子层：hub_b 的最近邻（d=1）───────────────────────────────────────────
@layer(time=1, thread=0, coord=(101), cost=1, track=(entropy))
int32 leaf_b1() {
    auto q = new QuantumRegister(2);
    qgate_h(q, 0);
    qgate_cnot(q, 0, 1);                   // Bell 态（纠缠熵 = ln 2）
    double s = qstate_entropy(q);
    int32 ok = 0;
    if (s > 0.68 && s < 0.71) {
        ok = 1;
    }
    rvdl_sys_logi(5, ok);
    return ok;
}

// ── 叶子层：hub_b 的次近邻（d=1）───────────────────────────────────────────
@layer(time=1, thread=0, coord=(102), cost=1, track=(expect_z))
int32 leaf_b2() {
    auto q = new QuantumRegister(2);
    qgate_h(q, 0);
    double z = qexpect_z(q, 0);
    int32 ok = 0;
    if (z < 0.0001 && z > -0.0001) {
        ok = 1;
    }
    rvdl_sys_logi(6, ok);
    return ok;
}
