@layer(time=0, thread=0, coord=(1,0))
int32 ilog2_ceil(int32 v) {
    int32 r = 0;
    while ((1 << r) < v) {
        r = r + 1;
    }
    return r;
}

@layer(time=0, thread=0, coord=(0,0))
int32 rvdl_main() {
    int32 s1 = 0;
    s1 = s1 + (0 ^ (1 << 0));
    s1 = s1 + (0 ^ (1 << 1));
    s1 = s1 + (0 ^ (1 << 2));
    s1 = s1 + (0 ^ (1 << 3));
    s1 = s1 + (3 ^ (1 << 1));
    s1 = s1 + (6 ^ (1 << 1));
    s1 = s1 + (5 ^ (1 << 2));

    int32 s2 = 0;
    s2 = s2 + ilog2_ceil(1);
    s2 = s2 + ilog2_ceil(2);
    s2 = s2 + ilog2_ceil(3);
    s2 = s2 + ilog2_ceil(4);
    s2 = s2 + ilog2_ceil(5);
    s2 = s2 + ilog2_ceil(8);

    int32 s3 = 0 + (1 << (3 - 1));

    int32 s4 = 0 ^ (1 << 3);

    return s1 + s2 + s3 + s4;
}