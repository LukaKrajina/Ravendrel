// ============================================================================
// 追踪（track）：把可观测量在块的功能周期内转成经典影子再恢复
//
// ── 为什么必须是三级阶梯，而不是一个「精确克隆」────────────────────────────
//
//   单次软克隆在物理上**不可能**。反证很短：对未知态 |ψ> = α|0> + β|1>
//   测 Z 得到结果 b，测量后态是 |b> —— 逆推只能得回 |b>，相位 α/β 已不可
//   恢复。因此任何「一次抽取、精确复制」的承诺都是假的。
//
//   追踪给出的是三级**诚实的**阶梯（每级各自声明自己的保真契约）：
//
//     L0 qnd      非破坏读出。仅对 Pauli 族存在（Peierls 定理：Pauli 测量的
//                 统计量对同类 Pauli 可观测量的期望零扰动）。保真度 = 1。
//     L1 shadow   经典阴影采样。任意可观测量，**统计级**承诺：采样 N 次后
//                 保真下界 1 − 1/√N，恒 < 1 —— 不伪装成精确。
//     L2 relabel  纯经典量（维数、香农熵…）。态从不被触碰，只是重贴标签。
//                 保真度 = 1，但原因与 L0 不同：它没碰过态。
//
//   `track_mode=0`（默认）按可观测量的**族**自动选级：
//     expect_z / expect_x / expect_y           → L0
//     entropy / fidelity / attention / measure_* → L1
//     num_qubits / shannon4 / shannon8 / amplitude → L2
//
//   `track_mode` 取非 0 时**强制覆盖** auto 选级（2→L1、3→L2；
//   1→L0 且对非 Pauli 族报 E-TRK003 —— 非 Pauli 族不存在非破坏读出电路）。
//   强制必须真的改变级别，否则这个键就是哑参数。
//
// ── 影子槽为什么是经典标量 ─────────────────────────────────────────────────
//
//   影子槽（runtime 的 ShadowEntry = {double, bool}）是**结构上**不可能
//   持有量子态的类型，且只在块的**功能周期** [time, time+cost) 内存活，
//   窗口退出即释放。这正是保 QLT 线性不变量 E-Q001（不可克隆）/
//   E-Q002（线性值泄漏）的方式：被测量的是影子，不是原态。
//
//   也正因窗口会关闭，跨窗口传递走的不是影子本身，而是**渗透载荷**
//   （经典关联标量）—— 见 examples/shuttle_relay.rvdl。
//
// ── 运行后看什么 ───────────────────────────────────────────────────────────
//
//   stdout 里的 [Track] 行会打印每个作用域、每个可观测量的**实际级别**：
//     [Track] enter block=prepare obs=expect_z   level=0 samples=1
//     [Track] enter block=prepare obs=entropy    level=1 samples=21 …
//     [Track] enter block=prepare obs=num_qubits level=2 samples=0
//     [Track] enter block=forced  obs=expect_z   level=2 …   ← 被 track_mode=3 强制
//     [Track] enter block=statistical obs=expect_z level=1 … ← 被 track_mode=2 强制
//     [Track] exit block=prepare (影子槽已释放)
//
// 运行：rvdl run examples/tracking_shadow.rvdl（需先启动 runtime daemon）
// 规格：docs/rvdl-shuttle-tracking.md §4
// ============================================================================

// ── 三种族并置：auto 会在同一个作用域里给出三个不同级别 ─────────────────────
@layer(time=0, thread=0, coord=(0,0), cost=1,
       shuttle=((1,0)),
       track=(expect_z, entropy, num_qubits))
int32 prepare() {
    int32 ok = 0;

    // ── L0 的物理内容：Pauli 族读出**不消费**对象 ──────────────────────────
    // |0>：<Z> = 1。qexpect_z 是**非破坏**访问器 —— 同一个对象可以再读一次，
    // 值不变。这正是 L0 敢承诺保真度 = 1 的语言层依据。
    //
    // 关键区分（本示例的题眼）：破坏性的 measure / measure_x / measure_y
    // **消费**对象，而非破坏性的 qexpect_* / qstate_* / qobj_* 不消费。
    // 这个分界不是实现细节，它就是阶梯本身在语言里的形态。
    auto z = new QuantumRegister(1);
    double z1 = qexpect_z(z, 0);
    double z2 = qexpect_z(z, 0);           // 再用一次同一个对象：合法且值相同
    if (z1 > 0.99 && z2 > 0.99) {
        ok = ok + 1;                       // 1：非破坏读出可重复（L0 依据）
    }
    if (z1 - z2 < 0.000000001 && z2 - z1 < 0.000000001) {
        ok = ok + 1;                       // 2：两次读出严格一致（读数稳定）
    }

    // ── L2 的物理内容：纯经典量读出后**态仍可用** ─────────────────────────
    // qobj_num_qubits 属于 L2「重贴标签」：它只读结构，不碰态。
    // 可操作性证据：读完之后同一个对象还能继续用于依赖态的运算。
    // 若 L2 偷偷碰了态，这里的纠缠熵就会算出来不对。
    auto q = new QuantumRegister(2);
    qgate_h(q, 0);
    qgate_cnot(q, 0, 1);                   // Bell 对：(|00> + |11>)/√2
    int32 n = qobj_num_qubits(q);          // L2 读出
    double s = qstate_entropy(q);          // 依赖态的运算，仍可执行
    if (n == 2) {
        ok = ok + 1;                       // 3：维数直接命中
    }

    // ── L1 的物理内容：统计级量只有统计级信息 ─────────────────────────────
    // Bell 对的约化熵 = ln 2 ≈ 0.6931。它不是某次采样的产物，而是**分布**
    // 的性质 —— 故 L1 只能承诺 1 − 1/√N 这类收敛下界，恒 < 1，绝不等于 1。
    if (s > 0.68 && s < 0.71) {
        ok = ok + 1;                       // 4：纠缠熵 ≈ ln 2
    }

    rvdl_sys_logi(1, ok);                  // 期望 4
    return ok;
}

// ── 为什么「一次抽取、精确复制」不可能（本示例的负向证据）───────────────────
//
//   把下面这个程序交给编译器，它会被**拒绝**：
//
//     int32 g() {
//         auto p = alloc();
//         qgate_h(p, 0);              // |+>，<X> = 1
//         int32 b = measure(p, 0);    // Z 基读出（**消费** p）
//         double x = qexpect_z(p, 0); // ← E-Q001：p 已被消费
//         return b;
//     }
//
//   `E-Q001`（no-cloning）就是「单次软克隆不可能」在编译期的形态：
//   读出必须消费，于是「读一次、再读一次」写不出来；而克隆又被禁止，
//   于是也没有绕过路径。这与物理结论完全一致 —— 测 Z 得 b 之后测量后态
//   是 |b>，逆推只能得回 |b>，相位已不可恢复。
//
//   所以追踪不承诺统一精确，只给三级**各自声明契约**的阶梯。
//   该拒绝由 server/src/tracking.test.ts 钉住（「E-Q001 no-cloning 照常报出」）。

// ── 功能周期 = [time, time+cost)：cost=3 → 窗口 [1,4) ───────────────────────
// 影子槽在窗口内存在、窗口退出即释放。窗口不是「尽量延长」，而是由
// cost 决定的有限区间 —— 跨窗口的关联只能走渗透载荷。
@layer(time=1, thread=0, coord=(1,0), cost=3, track=(expect_z, entropy))
int32 audit() {
    auto q = new QuantumRegister(2);
    qgate_h(q, 0);
    qgate_cnot(q, 0, 1);                   // Bell 对
    double z = qexpect_z(q, 0);            // <Z> = 0（边缘态完全混合）
    double s = qstate_entropy(q);
    int32 ok = 0;
    if (z < 0.0001 && z > -0.0001) {
        ok = 1;
    }
    if (s > 0.60 && s < 0.79) {
        ok = ok + 1;
    }
    rvdl_sys_logi(2, ok);                  // 期望 2
    return ok;
}

// ── 强制 mode=3（relabel/L2）：该键必须真的改变级别 ─────────────────────────
// 本块 auto 本会给 [L0, L2]（expect_z → 0、num_qubits → 2）；
// track_mode=3 把**两者都**压到 L2，于是 expect_z 的级别从 0 变为 2。
// 若级别没变，就说明这个键是哑参数 —— 那正是被测试钉住的失效模式。
@layer(time=1, thread=0, coord=(2,0), cost=1, track_mode=3,
       track=(expect_z, num_qubits))
int32 forced() {
    int32 ok = 0;
    auto q = new QuantumRegister(2);
    if (qobj_num_qubits(q) == 2) {
        ok = 1;
    }
    rvdl_sys_logi(3, ok);
    return ok;
}

// ── 强制 mode=2（shadow/L1）：把一个本可 L0 的量降级 ────────────────────────
// auto 会给 expect_z → L0（精确）；强制 L1 后它变成统计级采样，
// 保真契约从 = 1 变成 1 − 1/√N < 1。**降级方向**也要能被强制：
// 若只能升不能降，track_mode 就只覆盖了一半取值域。
@layer(time=1, thread=0, coord=(3,0), cost=1, track_mode=2, track=(expect_z))
int32 statistical() {
    auto q = new QuantumRegister(1);
    double z = qexpect_z(q, 0);            // |0> → 1
    int32 ok = 0;
    if (z > 0.99) {
        ok = 1;
    }
    rvdl_sys_logi(4, ok);
    return ok;
}
