@layer(time=0, thread=0, coord=(1,0))
int32 my_handler() {
    return 1;
}

@layer(time=0, thread=0, coord=(0,0))
int32 rvdl_main() {
    cap<int32> idt = rvdl_gc_alloc(16);

    int32 a = addr(&my_handler);

    *(idt + 0) = (a & 65535) | (8 << 16);
    *(idt + 1) = 36352 | (((a >> 16) & 65535) << 16);
    *(idt + 2) = 0;
    *(idt + 3) = 0;

    int32 low16 = *(idt + 0) & 65535;
    int32 mid16 = *(idt + 1) >> 16;
    int32 back = low16 | (mid16 << 16);

    if (back == a) { return 1; }
    return 0;
}