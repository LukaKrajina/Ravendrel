// ============================================================================
// 穿梭（shuttle）：跨关联层的双向关联度渗透
//
// ── 拓扑 ───────────────────────────────────────────────────────────────────
//
//           relay
//          coord=(1)          d_L1 = 1   ← 最近邻中继
//            │
//   sense ───┼───────────────  amplify
//  coord=(0)│                  coord=(2)          d_L1 = 2
//            └───────────────  archive
//                               coord=(800)        d_L1 = 800
//
//   `archive` 是**故意**放在下溢墙之外的：线性权重 w = exp(−800) 在双精度
//   下溢为 0，但它仍然留在调度计划里 —— 下溢是数值现象，不是语义截断。
//
// ── 关联核 ─────────────────────────────────────────────────────────────────
//
//   w = exp(−d_L1 / λ)，本图 λ = 1（shuttle_lambda=1），d_L1 为 L1 码距。
//
//   两条纪律（见 docs/rvdl-shuttle-tracking.md §2.3 / §5.1）：
//     ① 核**严格为正、不设截断阈值**。注意力 softmax 会把小权重压到近 0
//        并丢弃，穿梭不这么做：哪怕关联度极小也有效。
//     ② **路由一律用 logWeight = −d/λ**，weight 仅用于线性混合。
//        二者同时下发：d/λ ≳ 745 时 weight 整零、logWeight 仍严格可分辨。
//
// ── 运行后看什么 ───────────────────────────────────────────────────────────
//
//   stdout 里的 [Shuttle] 行会打印（运行诊断，非静默）：
//     from=sense strategy=0 (auto) phase=2 rounds=10 peers=3 λ=1 span=801 …
//       · strategy 显示 auto 实际选中的策略 —— 决策可见
//       · rounds = ⌈log₂(801)⌉ = 10（蝶式深度，见 §3.4）
//       · peers = 3：**三个对端全部在计划内**，含已下溢的 archive
//
//   本文件自身的自检项验证的是**对数空间**的性质 —— 那正是路由实际使用的
//   量，也是唯一在越墙之后仍然良定义的量（语言里没有 exp()，故线性权重
//   由上面的运行诊断为证）。
//
// 运行：rvdl run examples/shuttle_relay.rvdl（需先启动 runtime daemon）
// 规格：docs/rvdl-shuttle-tracking.md
// ============================================================================

// λ 必须与下面 @layer 里的 shuttle_lambda 一致：标签是规划器的权威值，
// 此处只是把它取出来供函数体做算术，两处不能各自漂移。
// （改标签时记得改这里 —— 这是唯一一处人工同步点。）
fixed double LAMBDA = 1.0;

// ── 源块：既声明穿梭目标，也声明追踪集 ──────────────────────────────────────
// 必须同时有 track=，否则 W-SHU001 会正确指出「声明了相干穿梭却没人供给影子」。
@layer(time=0, thread=0, coord=(0), cost=1,
       shuttle=((1),(2),(800)), shuttle_lambda=1, shuttle_phase=2, shuttle_strategy=-1,
       track=(expect_z, entropy))
int32 sense() {
    int32 ok = 0;

    // ── 自检 1：对数空间的**可加性** ────────────────────────────────────────
    // logWeight 对距离是线性的：logW(a) + logW(b) == logW(a+b)。
    // 这正是「距离相加 = 权重相乘」在 log 空间的对应物，也是路由能用
    // 简单加法在任意远距离上精确比较的原因（线性空间早就下溢了）。
    //
    // 这里刻意用一个**与本标签无关**的 λ=3 来做这条检查：
    // λ=1 配整数距离会得到精确的整数等式（−1 + −2 == −3），
    // 那种等式恒真、测不出任何东西；λ=3 让三项都不精确可表示，
    // 可加性于是变成一条**真的会因浮点实现出错而失败**的断言。
    double L3 = 3.0;
    double lw1 = -1.0 / L3;
    double lw2 = -2.0 / L3;
    double lw3 = -3.0 / L3;
    if (lw1 + lw2 - lw3 < 0.000000001 && lw1 + lw2 - lw3 > -0.000000001) {
        ok = ok + 1;                       // 1：logWeight 可加（非整数 λ 下仍成立）
    }

    // ── 自检 2：越墙之后仍然**严格可分辨** ─────────────────────────────────
    // d=800（archive）远在整零阈值（≈745）之外。此时线性权重已全为 0，
    // 若用 weight 排序会得到任意顺序；用 logWeight 则精确还原「近 → 远」。
    double far1 = -800.0 / LAMBDA;
    double far2 = -801.0 / LAMBDA;
    double far3 = -802.0 / LAMBDA;
    if (far1 > far2 && far2 > far3) {
        ok = ok + 1;                       // 2：越墙后对数序仍严格
    }
    // 三个值两两不等 —— 「都等于 0」那种退化没有发生
    if (far1 != far2 && far2 != far3 && far1 != far3) {
        ok = ok + 1;                       // 3：越墙后两两可分辨
    }

    // ── 自检 3：核**不留零**（无截断阈值）──────────────────────────────────
    // 构造一个极远的对端：d 取到 10^6。任何**阈值型**实现都会在这里
    // 返回 0 或直接丢弃该对端；对数形式必须仍然有限。
    // 「有限」用有界区间而不是自减法来验：对 ±inf / NaN，区间检查会假，
    // 而 `x − x == 0` 这类写法只是在测同一个东西还能不能减。
    double extreme = -1000000.0 / LAMBDA;
    if (extreme < far1 && extreme > -2000000.0) {
        ok = ok + 1;                       // 4：d=10^6 处对数权重仍有限、仍更小
    }

    // ── 自检 4：追踪集里的可观测量本身是真的 ───────────────────────────────
    // 声明 track=(expect_z, entropy) 的含义是「这两个量在块的作用域内被
    // 转成经典影子再恢复」。此处算出它们的真值，作为后续对账的基准。
    auto q = new QuantumRegister(2);
    qgate_h(q, 0);
    qgate_cnot(q, 0, 1);                   // Bell 态：(|00> + |11>)/√2

    // expect_z 属 Pauli 族 → L0（非破坏读出，保真度 = 1）
    double z0 = qexpect_z(q, 0);
    if (z0 < 0.0001 && z0 > -0.0001) {
        ok = ok + 1;                       // 5：Bell 态边缘期望 <Z> = 0
    }
    // entropy 属统计族 → L1（经典阴影，采样收敛而非单次精确）
    double s = qstate_entropy(q);
    // Bell 态约化熵 = ln 2 ≈ 0.6931
    if (s > 0.68 && s < 0.71) {
        ok = ok + 1;                       // 6：纠缠熵 ≈ ln 2
    }
    // num_qubits 属经典族 → L2（态从不被触碰，纯重标记）
    if (qobj_num_qubits(q) == 2) {
        ok = ok + 1;                       // 7：维数直接读出
    }

    rvdl_sys_logi(1, ok);                  // 期望 7
    return ok;
}

// ── 最近邻中继：关联度最强（d=1）───────────────────────────────────────────
// 它自己也是一个追踪作用域，可观测量的族与源不同，用以展示三级阶梯共存。
@layer(time=1, thread=0, coord=(1), cost=1, track=(expect_z))
int32 relay() {
    auto q = new QuantumRegister(1);
    qgate_h(q, 0);                         // (|0> + |1>)/√2
    double z = qexpect_z(q, 0);            // <Z> = 0
    int32 ok = 0;
    if (z < 0.0001 && z > -0.0001) {
        ok = 1;
    }
    rvdl_sys_logi(2, ok);
    return ok;
}

// ── 次近邻：d=2 ────────────────────────────────────────────────────────────
@layer(time=1, thread=0, coord=(2), cost=1, track=(entropy))
int32 amplify() {
    auto q = new QuantumRegister(2);
    qgate_h(q, 0);
    qgate_cnot(q, 0, 1);                   // 再用一次 Bell 态（纠缠熵 = ln 2）
    double s = qstate_entropy(q);
    int32 ok = 0;
    if (s > 0.68 && s < 0.71) {
        ok = 1;
    }
    rvdl_sys_logi(3, ok);
    return ok;
}

// ── 远端归档节点：d=800，**线性权重已整零**，但在计划内 ────────────────────
@layer(time=1, thread=0, coord=(800), cost=1, track=(num_qubits))
int32 archive() {
    auto q = new QuantumRegister(4);
    int32 n = qobj_num_qubits(q);
    int32 ok = 0;
    if (n == 4) {
        ok = 1;
    }
    rvdl_sys_logi(4, ok);
    return ok;
}
